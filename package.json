{
  "$schema": "https://json.schemastore.org/package",
  "name": "repo",
  "version": "0.0.0",
  "description": "",
  "homepage": "https://github.com/temptodo/temptodo#readme",
  "bugs": {
    "url": "https://github.com/temptodo/temptodo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/temptodo/temptodo.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "lint": "turbo run lint lint:root",
    "lint:fix": "turbo run lint:fix lint:fix:root",
    "lint:root": "oxlint",
    "lint:fix:root": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky"
  },
  "dependencies": {
    "oxfmt": "^0.66.0"
  },
  "devDependencies": {
    "@repo/configs": "*",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxlint": "^1.81.0",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc}": [
      "oxfmt"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.9.0"
    }
  }
}
