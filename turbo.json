{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "//#typecheck:root": {},
    "lint": {
      "dependsOn": ["^lint"]
    },
    "//#lint:root": {},
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "//#lint:fix:root": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "db:generate": {
      "cache": false,
      "outputs": ["./drizzle/**"]
    },
    "db:migrate": {
      "cache": false
    }
  }
}
